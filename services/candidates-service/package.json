{
  "name": "ats-candidates-service",
  "version": "1.0.0",
  "private": true,
  "description": "Candidate profiles, CV storage and job applications (owner: Laila). Runs as the ats-candidates-service Lambda.",
  "main": "src/lambda.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
